# Opt-in tooling. Installed by 'make brew-optional', never by 'make all'.
#
# These are here rather than in the core Brewfile because they are large,
# situational, or both. Promote anything you find yourself installing on every
# machine into Brewfile.

# --- containers --------------------------------------------------------------
# The runtime moved to the core Brewfile (cask "docker-desktop"). OrbStack used to
# be listed here and was removed rather than kept as an alternative: it provides
# its own `docker` CLI and daemon, so having both installed means two runtimes
# fighting over the same socket and CLI name. Same reason docker-compose is gone —
# Docker Desktop ships Compose as a plugin, and the standalone formula shadows it.
brew "lazydocker"      # TUI; no runtime of its own, so it layers cleanly

# --- cloud -------------------------------------------------------------------
brew "awscli"
brew "opentofu"        # Terraform fork under the Linux Foundation; the
                       # starship.toml terraform module reads its state too
brew "kubernetes-cli"
brew "k9s"
